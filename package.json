{
  "name": "@nebula.js/sn-legend",
  "version": "1.0.0",
  "description": "Display a standalone legend to identify colors used by other charts on a sheet. Use a categorical legend to label dimension values, or a gradient legend to show the range of a measure. Combine with an expression to apply custom colors across multiple visualizations.",
  "author": "QlikTech International AB",
  "license": "MIT",
  "keywords": [
    "qlik",
    "nebula",
    "supernova",
    "legend"
  ],
  "qext": {
    "name": "Legend",
    "icon": "list"
  },
  "main": "dist/sn-legend.js",
  "systemjs": "dist/sn-legend.systemjs.js",
  "files": [
    "dist",
    "core",
    "sn-legend-ext"
  ],
  "scripts": {
    "build": "node ./tools/build.js --core --ext",
    "build:dev": "node ./tools/build.js --core --ext --mode development",
    "build:watch": "node ./tools/build.js --mode development -w",
    "start": "nebula serve --type legend",
    "lint": "eslint src",
    "test": "jest",
    "test:unit": "jest",
    "deploy": "node ./tools/copy-ext.js"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/preset-env": "7.29.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "5.18.0",
    "@nebula.js/cli": "6.7.0",
    "@nebula.js/cli-build": "6.7.0",
    "@nebula.js/cli-sense": "6.7.0",
    "@nebula.js/cli-serve": "6.7.0",
    "@nebula.js/stardust": "6.7.0",
    "@qlik/animations": "file:../la-vie-main/chart-modules/animations",
    "@qlik/chart-commons": "file:../la-vie-main/chart-modules/chart-commons",
    "@qlik/custom-tooltips": "file:../la-vie-main/chart-modules/custom-tooltips",
    "@qlik/hooks": "file:../la-vie-main/chart-modules/hooks",
    "@qlik/la-vie-locale": "file:../la-vie-main/chart-modules/locale",
    "@qlik-trial/encoder": "file:./stubs/encoder",
    "d3-scale": "2.2.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "babel-jest": "^29.7.0",
    "chai": "6.2.2",
    "chai-as-promised": "8.0.2",
    "chai-subset": "1.6.0",
    "extend": "3.0.2",
    "fs-extra": "11.3.4",
    "hammerjs": "2.0.8",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-junit": "16.0.0",
    "node-event-emitter": "0.0.1",
    "picasso-plugin-hammer": "2.10.0",
    "picasso-plugin-q": "2.10.0",
    "picasso.js": "2.10.0",
    "qlik-chart-modules": "0.100.0",
    "qlik-object-conversion": "0.17.1",
    "sinon": "21.0.2",
    "sinon-chai": "4.0.1",
    "yargs": "18.0.0"
  },
  "peerDependencies": {
    "@nebula.js/stardust": ">=1.7.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  }
}
